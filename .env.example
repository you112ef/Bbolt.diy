# AI Platform Environment Configuration
# Copy this file to .env and fill in your values

# Build Optimization
NODE_ENV=production
VITE_DISABLE_SOURCEMAPS=true
VITE_OPTIMIZE_BUILD=true

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Local AI (Ollama)
OLLAMA_API_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Alternative Local AI
LMSTUDIO_API_BASE_URL=http://localhost:1234/v1
TOGETHER_API_BASE_URL=https://api.together.xyz

# Database (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication
AUTH_SECRET=your_auth_secret_here
SESSION_SECRET=your_session_secret_here

# Deployment
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Vercel Integration
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here

# Netlify Integration
NETLIFY_TOKEN=your_netlify_token_here
NETLIFY_SITE_ID=your_netlify_site_id_here

# Stripe Integration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Redis
REDIS_URL=your_redis_url_here
REDIS_PASSWORD=your_redis_password_here

# MongoDB
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB_NAME=your_mongodb_db_name_here

# Docker Hub
DOCKERHUB_USERNAME=your_dockerhub_username_here
DOCKERHUB_PASSWORD=your_dockerhub_password_here

# Railway
RAILWAY_TOKEN=your_railway_token_here
RAILWAY_PROJECT_ID=your_railway_project_id_here

# Heroku
HEROKU_API_KEY=your_heroku_api_key_here
HEROKU_APP_NAME=your_heroku_app_name_here

# PlanetScale
PLANETSCALE_DATABASE_URL=your_planetscale_database_url_here
PLANETSCALE_TOKEN=your_planetscale_token_here

# Build Performance
VITE_BUILD_TARGET=esnext
VITE_CHUNK_SIZE_WARNING_LIMIT=2000
VITE_DISABLE_LEGAL_COMMENTS=true
